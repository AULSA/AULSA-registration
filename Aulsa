<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AULSA Membership Registration Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        },
                        gold: {
                            500: '#eab308',
                            600: '#ca8a04',
                            700: '#a16207',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-brand-950 to-slate-900 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-brand-600 selection:text-white">

    <!-- Decorative background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-600/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -left-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="relative z-10 border-b border-slate-800/80 backdrop-blur-md bg-slate-900/60 sticky top-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('portal')">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-brand-600 to-gold-500 flex items-center justify-center shadow-lg shadow-brand-600/30">
                    <i class="fa-solid fa-scale-balanced text-white text-xl"></i>
                </div>
                <div>
                    <span class="text-xs font-bold tracking-widest text-gold-500 uppercase block">Arsi University</span>
                    <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white">AULSA Portal</h1>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 text-xs font-medium bg-slate-800/80 px-4 py-2 rounded-full border border-slate-700">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-slate-300">Registration Active</span>
                </div>
                <!-- Admin Toggle Button -->
                <button onclick="toggleAdminModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-semibold text-gold-400 flex items-center gap-2 transition-colors cursor-pointer">
                    <i class="fa-solid fa-shield-halved"></i> Admin Access
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 w-full flex-grow">
        
        <!-- Portal View -->
        <div id="portalView">
            <!-- Hero Section -->
            <div class="text-center mb-10">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold mb-4 tracking-wide uppercase">
                    <i class="fa-solid fa-award"></i> Academic Year 2026/2027
                </div>
                <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
                    ARSI UNIVERSITY LAW STUDENTS' ASSOCIATION
                </h2>
                <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto font-light">
                    Join our vibrant community of legal scholars, advocates, and future professionals. Register today to unlock exclusive academic resources, seminars, and networking.
                </p>
            </div>

            <!-- Registration Card Container -->
            <div class="bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-3xl shadow-2xl p-6 sm:p-10 relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-600 via-gold-500 to-brand-600"></div>

                <form id="registrationForm" class="space-y-8" onsubmit="handleFormSubmit(event)">
                    
                    <!-- Section 1: Personal Information -->
                    <div>
                        <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-4 pb-2 border-b border-slate-800">
                            <span class="w-7 h-7 rounded-lg bg-brand-600/20 text-brand-400 flex items-center justify-center text-sm font-semibold">1</span>
                            Personal & Academic Information
                        </h3>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- Full Name -->
                            <div>
                                <label for="fullName" class="block text-sm font-medium text-slate-300 mb-1.5">Full Name (As per University ID)</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-regular fa-user"></i>
                                    </span>
                                    <input type="text" id="fullName" name="fullName" required placeholder="e.g. Abebe Kebede Tadesse" 
                                        class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent transition-all text-sm">
                                </div>
                            </div>

                            <!-- ID Number -->
                            <div>
                                <label for="idNumber" class="block text-sm font-medium text-slate-300 mb-1.5">University ID Number</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-id-card"></i>
                                    </span>
                                    <input type="text" id="idNumber" name="idNumber" required placeholder="e.g. RU/1234/14" 
                                        class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent transition-all text-sm uppercase">
                                </div>
                            </div>

                            <!-- Batch -->
                            <div>
                                <label for="batch" class="block text-sm font-medium text-slate-300 mb-1.5">Batch / Academic Year</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </span>
                                    <select id="batch" name="batch" required
                                        class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent transition-all text-sm appearance-none">
                                        <option value="" disabled selected>Select your batch</option>
                                        <option value="1st Year">1st Year Regular</option>
                                        <option value="2nd Year">2nd Year Regular</option>
                                        <option value="3rd Year">3rd Year Regular</option>
                                        <option value="4th Year">4th Year Regular</option>
                                        <option value="5th Year">5th Year Regular</option>
                                        <option value="Alumni / Graduated">Alumni / Graduated (Golden Member)</option>
                                    </select>
                                    <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Gender -->
                            <div>
                                <label for="gender" class="block text-sm font-medium text-slate-300 mb-1.5">Gender</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-venus-mars"></i>
                                    </span>
                                    <select id="gender" name="gender" required
                                        class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-transparent transition-all text-sm appearance-none">
                                        <option value="" disabled selected>Select gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Membership Preference -->
                    <div>
                        <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-4 pb-2 border-b border-slate-800">
                            <span class="w-7 h-7 rounded-lg bg-brand-600/20 text-brand-400 flex items-center justify-center text-sm font-semibold">2</span>
                            Membership Category Preference
                        </h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Normal Membership -->
                            <label class="relative flex flex-col p-5 bg-slate-800/40 border-2 border-slate-700/80 rounded-2xl cursor-pointer hover:border-brand-600 transition-all group">
                                <input type="radio" name="membershipType" value="Normal Membership" required class="peer sr-only">
                                <div class="absolute top-5 right-5 w-5 h-5 rounded-full border-2 border-slate-600 peer-checked:border-brand-600 peer-checked:bg-brand-600 flex items-center justify-center transition-all">
                                    <div class="w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100"></div>
                                </div>
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 rounded-xl bg-brand-600/20 text-brand-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                        <i class="fa-solid fa-user-graduate"></i>
                                    </div>
                                    <div>
                                        <span class="text-white font-bold block">Normal Membership</span>
                                        <span class="text-xs text-slate-400">Regular Undergraduate Students</span>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-300 leading-relaxed">
                                    Designed for current undergraduate law students at Arsi University. Gain access to moot court sessions, tutorial classes, and study groups.
                                </p>
                            </label>

                            <!-- Golden Membership -->
                            <label class="relative flex flex-col p-5 bg-slate-800/40 border-2 border-slate-700/80 rounded-2xl cursor-pointer hover:border-gold-500 transition-all group">
                                <input type="radio" name="membershipType" value="Golden Membership" required class="peer sr-only">
                                <div class="absolute top-5 right-5 w-5 h-5 rounded-full border-2 border-slate-600 peer-checked:border-gold-500 peer-checked:bg-gold-500 flex items-center justify-center transition-all">
                                    <div class="w-2 h-2 rounded-full bg-slate-900 opacity-0 peer-checked:opacity-100"></div>
                                </div>
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                        <i class="fa-solid fa-crown"></i>
                                    </div>
                                    <div>
                                        <span class="text-white font-bold block">Golden Membership</span>
                                        <span class="text-xs text-gold-400 font-medium">For Graduates & Alumni</span>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-300 leading-relaxed">
                                    Exclusive tier for graduated law alumni of Arsi University. Support mentorship programs, networking events, and association growth.
                                </p>
                            </label>
                        </div>
                    </div>

                    <!-- Section 3: Payment Instructions & Details -->
                    <div class="bg-slate-950/60 border border-slate-800 rounded-2xl p-6">
                        <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-3">
                            <span class="w-7 h-7 rounded-lg bg-gold-500/20 text-gold-400 flex items-center justify-center text-sm font-semibold">3</span>
                            Payment Information & Verification
                        </h3>
                        <p class="text-xs sm:text-sm text-slate-300 mb-6">
                            Please transfer the membership fee using one of the official AULSA payment accounts listed below, enter your reference number, and upload your payment receipt screenshot.
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            <!-- CBE Account Box -->
                            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm">
                                        CBE
                                    </div>
                                    <div>
                                        <span class="text-xs text-slate-400 block font-medium">Commercial Bank of Ethiopia</span>
                                        <span id="cbeAccount" class="text-sm sm:text-base font-mono font-bold text-white tracking-wider">1000644916298</span>
                                    </div>
                                </div>
                                <button type="button" onclick="copyToClipboard('1000644916298', 'CBE Account')" class="p-2 text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition-colors text-xs font-medium flex items-center gap-1 cursor-pointer">
                                    <i class="fa-regular fa-copy"></i> Copy
                                </button>
                            </div>

                            <!-- Telebirr Account Box -->
                            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
                                        <i class="fa-solid fa-mobile-screen"></i>
                                    </div>
                                    <div>
                                        <span class="text-xs text-slate-400 block font-medium">Telebirr Account</span>
                                        <span id="telebirrNo" class="text-sm sm:text-base font-mono font-bold text-white tracking-wider">0975867401</span>
                                    </div>
                                </div>
                                <button type="button" onclick="copyToClipboard('0975867401', 'Telebirr Number')" class="p-2 text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition-colors text-xs font-medium flex items-center gap-1 cursor-pointer">
                                    <i class="fa-regular fa-copy"></i> Copy
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <!-- Transaction Reference Input -->
                            <div>
                                <label for="transactionRef" class="block text-sm font-medium text-slate-300 mb-1.5">Transaction Reference / Receipt Number</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="fa-solid fa-receipt"></i>
                                    </span>
                                    <input type="text" id="transactionRef" name="transactionRef" required placeholder="e.g. FT2409... or Telebirr ID" 
                                        class="w-full pl-10 pr-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-5
